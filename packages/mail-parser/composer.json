{
    "name": "phpdot/mail-parser",
    "description": "Zero-dependency RFC-compliant EML/email parser for PHP 8.5+",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Hamdan",
            "email": "omar@phpdot.com"
        }
    ],
    "keywords": [
        "email",
        "eml",
        "mime",
        "parser",
        "rfc5322",
        "rfc2045",
        "rfc2046",
        "rfc2047"
    ],
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "ext-iconv": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-4": {
            "PHPdot\\Mail\\Parser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPdot\\Mail\\Parser\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "ext-intl": "Checks internationalized domains in addresses against IDNA (UTS 46)"
    }
}
