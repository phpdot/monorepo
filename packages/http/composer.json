{
    "name": "phpdot/http",
    "description": "PSR-7 HTTP messages, responses, and uploads for modern PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Hamdan",
            "email": "omar@phpdot.com"
        }
    ],
    "keywords": [
        "http",
        "psr-7",
        "request",
        "response",
        "message"
    ],
    "require": {
        "php": ">=8.5",
        "league/mime-type-detection": "^1.16",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpdot/config": "^0.1",
        "phpdot/container": "^0.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "phpdot/container": "Autowires the container-attribute services and #[Config] DTOs declared in src (the attributes stay inert until reflected, so standalone consumers don't need it installed)."
    },
    "autoload": {
        "psr-4": {
            "PHPdot\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Http\\Psr7Test\\": "tests/Psr7/",
            "PHPdot\\Http\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=256M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@test",
            "@analyse",
            "@cs-check"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/phpdot/http",
        "issues": "https://github.com/phpdot/monorepo/issues"
    }
}
