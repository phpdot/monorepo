{
    "name": "phpdot/smtp-gateway",
    "description": "SMTP access gateway for PHP: accepts email from users' clients over SMTP, stores it, hands it to a transport.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Hamdan",
            "email": "omar@phpdot.com"
        }
    ],
    "keywords": [
        "smtp",
        "email",
        "gateway",
        "ses",
        "mail",
        "rfc5321"
    ],
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "PHPdot\\Mail\\Gateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPdot\\Mail\\Gateway\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
